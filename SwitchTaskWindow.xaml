<Window x:Class="TaskbarTimer.SwitchTaskWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="切换任务" Width="320" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="False" WindowStyle="ToolWindow"
        Background="{StaticResource ColorSurface}">
  <StackPanel Margin="16">
    <TextBlock Text="切换到哪个任务？（当前会话会先保存）" FontWeight="Bold"/>
    <TextBox x:Name="TaskInput" Margin="0,10,0,0" KeyDown="OnKeyDown"/>
    <TextBlock Text="最近任务：" Margin="0,14,0,4" Foreground="{StaticResource ColorTextMuted}"/>
    <ItemsControl x:Name="RecentList">
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Button Content="{Binding}" Style="{StaticResource SecondaryButton}"
                  HorizontalAlignment="Stretch" Margin="0,2" Click="OnRecentClick"/>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
      <Button Content="取消" Style="{StaticResource SecondaryButton}" Click="OnCancel"/>
      <Button Content="切换" Margin="8,0,0,0" Click="OnConfirm"/>
    </StackPanel>
  </StackPanel>
</Window>

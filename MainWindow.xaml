<Window x:Class="TaskbarTimer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="任务栏计时器" Height="560" Width="760" Icon="app.ico"
        WindowStartupLocation="CenterScreen" Background="{StaticResource ColorSurface}"
        Closing="OnClosing">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- 发起计时 -->
    <Border Grid.Row="0" Background="{StaticResource ColorBgLight}" CornerRadius="6" Padding="12">
      <StackPanel>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBlock Text="任务名称：" VerticalAlignment="Center"/>
          <TextBox x:Name="TaskInput" Grid.Column="1" Margin="4,0" KeyDown="OnTaskInputKeyDown"/>
          <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="8,0,0,0">
            <RadioButton x:Name="ModeUp" Content="正计时" IsChecked="True" VerticalAlignment="Center"
                         GroupName="mode" Margin="0,0,12,0" Checked="OnModeChanged"/>
            <RadioButton x:Name="ModeDown" Content="倒计时" VerticalAlignment="Center"
                         GroupName="mode" Checked="OnModeChanged"/>
          </StackPanel>
        </Grid>
        <StackPanel x:Name="CountdownPanel" Orientation="Horizontal" Margin="0,10,0,0" Visibility="Collapsed">
          <TextBlock Text="计划时长（分钟）：" VerticalAlignment="Center"/>
          <TextBox x:Name="MinutesInput" Width="60" Text="25" TextAlignment="Center"/>
          <Button Content="25" Style="{StaticResource SecondaryButton}" Margin="10,0,0,0" Click="OnPreset"/>
          <Button Content="45" Style="{StaticResource SecondaryButton}" Margin="6,0,0,0" Click="OnPreset"/>
          <Button Content="90" Style="{StaticResource SecondaryButton}" Margin="6,0,0,0" Click="OnPreset"/>
        </StackPanel>
        <StackPanel x:Name="TargetPanel" Orientation="Horizontal" Margin="0,10,0,0">
          <TextBlock Text="目标时长：" VerticalAlignment="Center"/>
          <RadioButton x:Name="TargetNone" Content="不设目标" GroupName="target" IsChecked="True"
                       VerticalAlignment="Center"/>
          <RadioButton Content="25 分钟" GroupName="target" Tag="25" VerticalAlignment="Center" Margin="12,0,0,0"/>
          <RadioButton Content="45 分钟" GroupName="target" Tag="45" VerticalAlignment="Center" Margin="12,0,0,0"/>
          <RadioButton Content="60 分钟" GroupName="target" Tag="60" VerticalAlignment="Center" Margin="12,0,0,0"/>
          <RadioButton Content="90 分钟" GroupName="target" Tag="90" VerticalAlignment="Center" Margin="12,0,0,0"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
          <Button x:Name="StartBtn" Content="开始计时" Padding="24,6" Click="OnStart"/>
          <Button x:Name="StopBtn" Content="结束并保存" Padding="24,6" Margin="10,0,0,0"
                  Style="{StaticResource SecondaryButton}" IsEnabled="False" Click="OnStop"/>
          <Button x:Name="SwitchBtn" Content="切换任务…" Style="{StaticResource SecondaryButton}"
                  Margin="10,0,0,0" IsEnabled="False" Click="OnSwitchTask"/>
          <Button x:Name="DistractionBtn" Content="我分心了" Style="{StaticResource SecondaryButton}"
                  Margin="6,0,0,0" IsEnabled="False" Click="OnDistraction"/>
          <TextBlock x:Name="LiveStatus" VerticalAlignment="Center" Margin="14,0,0,0"
                     Foreground="{StaticResource ColorTextMuted}"/>
        </StackPanel>
        <StackPanel x:Name="NotesPanel" Margin="0,10,0,0">
          <TextBlock Text="进展 / 拆解备忘："/>
          <Grid Margin="0,4,0,0">
            <TextBox x:Name="NotesInput" MinHeight="40" MaxHeight="200" Height="72"
                     AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                     TextChanged="OnNotesChanged"/>
            <Thumb x:Name="NotesResizeThumb" Width="14" Height="14"
                   HorizontalAlignment="Right" VerticalAlignment="Bottom"
                   Cursor="SizeNWSE" DragDelta="OnNotesResizeDragDelta">
              <Thumb.Template>
                <ControlTemplate TargetType="Thumb">
                  <Canvas Width="14" Height="14" Background="Transparent">
                    <Line X1="9" Y1="2" X2="13" Y2="6" Stroke="#9AA0A6" StrokeThickness="1.5"/>
                    <Line X1="4" Y1="2" X2="13" Y2="11" Stroke="#9AA0A6" StrokeThickness="1.5"/>
                  </Canvas>
                </ControlTemplate>
              </Thumb.Template>
            </Thumb>
          </Grid>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
          <CheckBox x:Name="CheckInEnabled" Content="注意力巡检" VerticalAlignment="Center"
                    Click="OnCheckInEnabledClick"/>
          <TextBlock Text="随机间隔" Margin="12,0,4,0" VerticalAlignment="Center"/>
          <TextBox x:Name="CheckInMin" Width="40" TextAlignment="Center" TextChanged="OnCheckInMinutesChanged"/>
          <TextBlock Text="~" Margin="3,0" VerticalAlignment="Center"/>
          <TextBox x:Name="CheckInMax" Width="40" TextAlignment="Center" TextChanged="OnCheckInMinutesChanged"/>
          <TextBlock Text="分钟" Margin="4,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- 每日汇总（单独一行，避免被右侧按钮遮挡）+ 筛选 -->
    <StackPanel Grid.Row="1" Margin="0,14,0,8">
      <TextBlock x:Name="SummaryText" FontWeight="Bold" TextWrapping="Wrap"/>
      <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
        <TextBlock Text="范围：" VerticalAlignment="Center" Margin="0,0,4,0"/>
        <ComboBox x:Name="RangeCombo" Width="90" SelectionChanged="OnRangeChanged">
          <ComboBoxItem Content="今天"/>
          <ComboBoxItem Content="近7天"/>
          <ComboBoxItem Content="全部"/>
        </ComboBox>
        <Button Content="任务统计" Style="{StaticResource SecondaryButton}" Margin="10,0,0,0" Click="OnStats"/>
        <Button Content="复制表格" Style="{StaticResource SecondaryButton}" Margin="6,0,0,0" Click="OnCopyTable"/>
        <Button Content="导出 CSV" Style="{StaticResource SecondaryButton}" Margin="6,0,0,0" Click="OnExport"/>
        <Button Content="再次计时" Style="{StaticResource SecondaryButton}" Margin="6,0,0,0" Click="OnReuseTask"/>
        <Button Content="重置小窗位置" Style="{StaticResource SecondaryButton}" Margin="6,0,0,0" Click="OnResetWidget"/>
        <Button Content="删除选中" Style="{StaticResource SecondaryButton}" Margin="6,0,0,0" Click="OnDelete"/>
        <Button Content="退出程序" Style="{StaticResource SecondaryButton}" Margin="6,0,0,0" Click="OnExit"/>
      </StackPanel>
    </StackPanel>

    <!-- 记录表 -->
    <DataGrid Grid.Row="2" x:Name="RecordsGrid" AutoGenerateColumns="False" CanUserAddRows="False"
              HeadersVisibility="Column" SelectionMode="Single" GridLinesVisibility="Horizontal"
              HorizontalGridLinesBrush="{StaticResource ColorBorder}" Background="White"
              MinHeight="150" MaxHeight="400"
              ClipboardCopyMode="IncludeHeader" MouseDoubleClick="OnRecordsDoubleClick">
      <DataGrid.Columns>
        <DataGridTextColumn Header="日期" Binding="{Binding Date}" IsReadOnly="True" Width="90"/>
        <DataGridTextColumn Header="开始时间" Binding="{Binding Start}" IsReadOnly="True" Width="80"/>
        <DataGridTextColumn Header="结束时间" Binding="{Binding End}" IsReadOnly="True" Width="80"/>
        <DataGridTextColumn Header="时长" Binding="{Binding DurationText}" IsReadOnly="True" Width="90"/>
        <DataGridTextColumn Header="专注事项" Binding="{Binding Task}" Width="*"/>
        <DataGridTextColumn Header="分心次数" Binding="{Binding DistractionText}" IsReadOnly="True" Width="80"/>
        <DataGridTextColumn Header="进展记录" Binding="{Binding Notes}" Width="2*"/>
      </DataGrid.Columns>
    </DataGrid>

    <TextBlock Grid.Row="3" Margin="0,8,0,0" Foreground="{StaticResource ColorTextMuted}"
               TextWrapping="Wrap"
               Text="提示：计时开始后，任务栏右侧会出现计时小窗；小窗单击=暂停/继续，双击=打开本窗口，悬停可看任务名。正计时可设目标（到点温和提醒）；注意力巡检会随机弹出且不抢焦点。倒计时结束会闪烁任务栏图标提醒；双击「专注事项」「进展记录」单元格可编辑（自动保存）；关闭本窗口只是隐藏，可从系统托盘（双击时钟图标）重新打开。"/>
  </Grid>
  </ScrollViewer>
</Window>
